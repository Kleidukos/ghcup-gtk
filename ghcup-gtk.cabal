cabal-version: 3.4
name: ghcup-gtk
version: 0.1.0.0
synopsis: GTK installer for the Haskell toolchain
-- description:
license: GPL-3.0-only
license-file: LICENSE
author: Hécate Moonlight
maintainer: hecate+github@glitchbra.in
-- copyright:
category: Distribution
build-type: Simple
data-files: data/style.css
extra-doc-files: CHANGELOG.md
tested-with: ghc ==9.14.1

flag development
  description: Reload the CSS provider when data/style.css changes
  default: True
  manual: True

-- extra-source-files:
common options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -fhide-source-paths
    -Wno-unused-do-bind
    -fshow-hole-constraints
    -Wno-unticked-promoted-constructors
    -fwrite-ide-info

  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    NoStarIsType
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  default-language: GHC2024

library core
  import: options
  hs-source-dirs: src/core
  -- cabal-gild: discover src/core
  exposed-modules:
    CLI
    Config
    Effects.FileSystem
    Effects.Ghcup
    Effects.Notify
    Presentation.Path
    Presentation.Row
    Session
    Toolchain.Curation
    Toolchain.GHCup
    Toolchain.Path
    Toolchain.Types
    Worker

  build-depends:
    base,
    containers,
    directory,
    effectful-core,
    filepath,
    ghcup,
    kdl-hs,
    mtl,
    optparse-applicative,
    pretty,
    resourcet,
    scientific,
    stm,
    text,
    text-display,
    time,
    variant,
    vector,
    versions,

library
  import: options
  hs-source-dirs: src/gtk
  -- cabal-gild: discover src/gtk
  exposed-modules:
    UI
    UI.Dialog
    UI.HeaderBar
    UI.PathBanner
    UI.Preferences
    UI.Registry
    UI.Shell
    UI.Shortcuts
    UI.ToolPanes
    UI.View
    UI.View.List
    UI.View.List.Row
    UI.View.Table

  other-modules: Paths_ghcup_gtk
  autogen-modules: Paths_ghcup_gtk

  if flag(development)
    cpp-options: -DDEVELOPMENT
    hs-source-dirs: src/dev
    other-modules: Development.Reload
  build-depends:
    base,
    containers,
    directory,
    effectful-core,
    ghcup,
    ghcup-gtk:core,
    gi-adwaita ^>=1.0,
    gi-gdk4,
    gi-gio ^>=2.0,
    gi-glib ^>=2.0,
    gi-gobject ^>=2.0,
    gi-gtk ^>=4.0,
    gi-pango ^>=1.0,
    haskell-gi-base,
    text,
    text-display,
    time,
    vector,

  pkgconfig-depends: libadwaita-1 >=1.5

executable ghcup-gtk
  import: options
  -- -threaded is load-bearing: the GTK main loop is a blocking foreign
  -- call; without OS threads the worker thread would never run
  ghc-options: -threaded
  main-is: Main.hs
  build-depends:
    base,
    ghcup-gtk,
    gi-adwaita,
    gi-glib,
    gi-gtk,
    haskell-gi-base,

  hs-source-dirs: app

test-suite ghcup-gtk-test
  import: options
  hs-source-dirs: test
  -- cabal-gild: discover test/ --exclude test/Main.hs
  other-modules:
    ConfigSpec
    Fixtures
    PresentationSpec
    SessionSpec
    TestInterpreters
    Toolchain.CurationSpec
    Toolchain.PathSpec
    WorkerSpec

  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends:
    base,
    containers,
    directory,
    effectful-core,
    filepath,
    ghcup,
    ghcup-gtk:core,
    tasty,
    tasty-hunit,
    text,
    time,
    vector,
    versions,
